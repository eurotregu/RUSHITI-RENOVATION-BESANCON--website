{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nom du Worker : l'URL sera https://rushiti-mcp-gbp.<sous-domaine>.workers.dev
  "name": "rushiti-mcp-gbp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    {
      "new_sqlite_classes": ["GbpMcp"],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "GbpMcp",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      // À remplacer par l'identifiant renvoyé par : npx wrangler kv namespace create OAUTH_KV
      "id": "A_COMPLETER_ID_KV"
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  }
}
